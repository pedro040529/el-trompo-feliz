# Copia este archivo a .env.local y completa los valores

# MongoDB Atlas (Database > Connect > Drivers). Incluye el nombre de la base al final.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/trompo

# Secreto para firmar la sesión (mínimo 16 caracteres). Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-largo

# Usuario administrador que crea "npm run seed"
ADMIN_EMAIL=admin@trompofeliz.pe
ADMIN_PASSWORD=cambia-esta-clave

# Stripe (modo pruebas) — se configura al final del proyecto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
